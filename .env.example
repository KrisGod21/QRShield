# All optional. Copy to .env
DEMO_MODE=1
ONLINE_CHECKS=1
FEEDS=1
# Google Safe Browsing v4 (free, non-commercial): https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=
